{
    "name": "catchdesign/twig-elemental",
    "type": "silverstripe-vendormodule",
    "description": "Allows use of twig with silverstripe-elemental in SilverStripe 6",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:catch-oss/silverstripe-twig.git"
        }
    ],
    "authors": [
        {
            "name": "Sam Etheridge",
            "email": "sam@etheridge.co.nz"
        }
    ],
    "require": {
        "php": "^8.5",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "azt3k/silverstripe-twig": "dev-release/6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "silverstripe/recipe-cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "CatchDesign\\SS\\TwigElemental\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CatchDesign\\SS\\TwigElemental\\Tests\\": "tests/"
        },
        "classmap": [
            "app/src/Page.php",
            "app/src/PageController.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        }
    }
}
